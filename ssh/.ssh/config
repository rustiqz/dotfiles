# ~/dotfiles/ssh/.ssh/config
#
# Tracked, but deliberately near-empty — the actual Host entries (real
# hostnames/IPs for work/demo machines) live in the untracked
# config.local this Include pulls in, same *.local escape-hatch
# pattern as git identity (hooks/50-git-identity.sh) and zsh's own
# .zshrc.local. .gitignore's existing ?*.local pattern already covers
# config.local — no new ignore rule needed.
#
# Include has to come before any Host block for its entries to be
# considered alongside (and, on conflict, override) anything defined
# below it — OpenSSH uses first-match-wins per option, so listing it
# first here means config.local's Host entries win over any generic
# fallback further down in this file.
Include ~/.ssh/config.local

# Sane baseline for every host, whether or not it's in config.local.
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
