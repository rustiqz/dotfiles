#!/usr/bin/env bash
#
# theme — whole-desktop theme switcher. Repoints each themeable app's
# active-theme.* symlink at themes/<name>/<file> and reloads whatever
# can reload live.
#
# Themes can be partial: every step below is individually skipped if
# the theme directory doesn't define that particular file — f1/, for
# example, currently only defines swaync.css and swaync-config.json,
# so switching to it leaves kitty/waybar/rofi/hyprland/GTK/Qt exactly
# as they were. Nothing breaks; those components just don't change.
#
# Usage:
#   theme <name>       e.g. theme tokyonight, theme f1, theme wallpaper
#   theme              interactive picker over themes/*/ (rofi) — always
#                       includes "wallpaper" even before it's ever been
#                       generated once (themes/wallpaper/ doesn't exist
#                       on disk until then; it's gitignored, generated
#                       output, not a hand-authored theme)
#
# "wallpaper" is special-cased below: unlike every other entry (a fixed
# hand-written themes/<name>/ directory), it's regenerated from
# whatever ~/.local/share/wallpapers/.current currently is, via matugen
# (matugen/config.toml + matugen/templates/*.tpl), every single time
# `theme wallpaper` runs — never automatically on a wallpaper pick, a
# deliberate separate step (see CLAUDE.md).

set -uo pipefail   # deliberately not -e: one missing/failed step
                    # (e.g. waybar not running to restart) shouldn't
                    # abort the rest of the switch

DOTFILES="$HOME/dotfiles"
THEMES_DIR="$DOTFILES/themes"

if [[ $# -eq 1 ]]; then
  NAME=$1
else
  NAME=$( { find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'; echo wallpaper; } \
    | sort -u | rofi -dmenu -p "Theme")
  [[ -z $NAME ]] && exit 0
fi

if [[ $NAME == wallpaper ]]; then
  WALLPAPER_IMG=$(readlink -f "$HOME/.local/share/wallpapers/.current")
  if [[ ! -f $WALLPAPER_IMG ]]; then
    echo "no current wallpaper set (~/.local/share/wallpapers/.current) — pick one with 'wallpaper' first" >&2
    exit 1
  fi

  mkdir -p "$THEMES_DIR/wallpaper"

  # matugen needs a literal path in config.toml (TOML has no env-var
  # expansion) — sed the __DOTFILES__ placeholder into a throwaway
  # copy rather than hardcoding a username into the tracked config, so
  # this still works if the repo ever lives under a different $HOME.
  TMP_CONFIG=$(mktemp --suffix=.toml)
  trap 'rm -f "$TMP_CONFIG"' EXIT
  sed "s|__DOTFILES__|$DOTFILES|g" "$DOTFILES/matugen/config.toml" > "$TMP_CONFIG"

  echo "Generating palette from $(basename "$WALLPAPER_IMG")..."
  if ! matugen image "$WALLPAPER_IMG" --config "$TMP_CONFIG" \
      -m dark -t scheme-tonal-spot --prefer saturation; then
    echo "matugen failed — leaving themes/wallpaper/ as it was" >&2
    exit 1
  fi
fi

THEME_DIR="$THEMES_DIR/$NAME"
if [[ ! -d $THEME_DIR ]]; then
  echo "no such theme: $NAME (looked in $THEME_DIR)" >&2
  exit 1
fi

echo "Applying theme: $NAME"

link() {
  # link <theme-file> <target-symlink-path>
  local src="$THEME_DIR/$1" dst="$2"
  [[ -f $src ]] || return 0
  ln -sfr "$src" "$dst"
}

# --- kitty -------------------------------------------------------------------
link "kitty.conf" "$DOTFILES/kitty/.config/kitty/active-theme.conf"

# --- waybar --------------------------------------------------------------------
if link "waybar.css" "$DOTFILES/waybar/.config/waybar/active-theme.css"; then
  UNIT=$(systemctl --user list-units 'app-Hyprland-waybar-*' --no-legend 2>/dev/null | awk '{print $1}')
  if [[ -n $UNIT ]]; then
    systemctl --user stop "$UNIT"
    setsid uwsm app -- waybar >/dev/null 2>&1 &
    disown
  fi
fi

# --- rofi ------------------------------------------------------------------
# No daemon to reload — picked up next time it's launched.
link "rofi.rasi" "$DOTFILES/rofi/.config/rofi/active-theme.rasi"

# --- Hyprland (compositor borders + hyprlock) -------------------------------
if link "hyprland.conf" "$DOTFILES/hypr/.config/hypr/active-theme.conf"; then
  command -v hyprctl &>/dev/null && hyprctl reload &>/dev/null
fi

# --- wlogout (power menu) -----------------------------------------------------
# No daemon to reload — layer-shell CSS is re-read fresh every time
# wlogout is launched (it's not a persistent background process).
link "wlogout.css" "$DOTFILES/wlogout/.config/wlogout/active-theme.css"

# --- yazi (file manager) -----------------------------------------------------
# Directory symlink, not a single file via link(): yazi looks up
# flavors by directory name under ~/.config/yazi/flavors/<name>.yazi/,
# so active-theme.yazi has to be a whole directory pointing at
# themes/<name>/yazi-flavor/, not one linked file like every other app
# here. -T on ln is required, not cosmetic: without it, re-running this
# against an *existing* directory symlink nests the new link inside the
# old target instead of replacing it (confirmed by testing a second
# `theme <name>` switch). No daemon to reload — flavor is read fresh on
# next launch, same as wlogout/rofi.
if [[ -d $THEME_DIR/yazi-flavor ]]; then
  mkdir -p "$DOTFILES/yazi/.config/yazi/flavors"
  ln -sfrT "$THEME_DIR/yazi-flavor" "$DOTFILES/yazi/.config/yazi/flavors/active-theme.yazi"
fi

# --- k9s (kubernetes TUI) ----------------------------------------------------
# Single-file link like everything else here (yazi's whole-directory
# case is the odd one out) — but note k9s resolves the skin by the
# symlink's *filename stem*, so this must stay `active-theme.yaml` to
# match the `ui.skin: active-theme` that hooks/75-k9s-skin.sh writes
# into config.yaml. No daemon to reload: k9s reads its skin once at
# startup, so a running instance keeps the old colors until it's
# restarted — same as rofi/wlogout, not a failure.
link "k9s-skin.yaml" "$DOTFILES/k9s/.config/k9s/skins/active-theme.yaml"

# --- ags (docker/music desktop widgets) -------------------------------------
# Same restart-in-place pattern as waybar above — ags has no live
# "reload css" IPC command (unlike swaync-client --reload-css), and the
# process is lightweight enough that a full restart is the simplest
# reliable option.
if link "ags.css" "$DOTFILES/ags/.config/ags/active-theme.scss"; then
  UNIT=$(systemctl --user list-units 'app-Hyprland-ags-*' --no-legend 2>/dev/null | awk '{print $1}')
  if [[ -n $UNIT ]]; then
    systemctl --user stop "$UNIT"
    setsid uwsm app -- ags run >/dev/null 2>&1 &
    disown
  fi
fi

# --- swaync --------------------------------------------------------------------
# swaync_reload <args...> — ask a *running* swaync to re-read its theme.
#
# `command -v swaync-client` is NOT a sufficient guard here, which is
# what this used to use. When the daemon isn't running, swaync-client
# doesn't fail: it tries to D-Bus-activate org.erikreider.swaync.cc,
# gets "NameHasNoOwner ... startup job failed", prints "Could not
# connect to CC service. Will wait for connection..." and then blocks
# forever waiting for a daemon that is never going to appear.
#
# That is not a rare edge case — it is the normal state during
# bootstrap. hooks/73-theme.sh calls this script, and on a machine
# being provisioned for the first time the bootstrap is necessarily
# being run from some *other* session (GNOME here), so swaync isn't up.
# 73-theme.sh is also the last hook, so the hang parked bootstrap.sh
# permanently one step from the end — long enough after the visible
# work that it reads as "finished" and gets Ctrl-C'd. Every run
# therefore skipped the remaining steps of this script (the Qt colour
# links and the uwsm env-theme link below) while still looking
# successful. Found by running this script under a timeout on a real
# clean machine, not by reading it.
#
# So: check for an actual process first, and still wrap the call in a
# timeout — the pidof check closes the race where swaync dies between
# the two, and guarantees no future caller of this script can hang on
# it regardless.
swaync_reload() {
  command -v swaync-client &>/dev/null || return 0
  pidof swaync &>/dev/null || return 0
  timeout 5 swaync-client "$@" &>/dev/null || true
}

if link "swaync.css" "$DOTFILES/swaync/.config/swaync/active-theme.css"; then
  swaync_reload --reload-css
fi
if [[ -f $THEME_DIR/swaync-config.json ]]; then
  cp "$THEME_DIR/swaync-config.json" "$DOTFILES/swaync/.config/swaync/config.json"
  swaync_reload -R
fi

# --- Qt (qt6ct + qt5ct share the same color scheme file) -------------------
link "qt-colors.conf" "$DOTFILES/qt6ct/.config/qt6ct/colors/active-theme.conf"
link "qt-colors.conf" "$DOTFILES/qt5ct/.config/qt5ct/colors/active-theme.conf"

# --- uwsm env (XCURSOR_*, QT_QPA_PLATFORMTHEME) -----------------------------
# env-theme, not env: env itself is a permanent tracked file (PATH,
# not theme-specific) that sources env-theme — see
# uwsm/.config/uwsm/env. Symlink updates immediately; the env vars
# themselves only take effect for anything started after the *next*
# full session login (UWSM reads this file once, at session start) —
# not something this script can force live.
link "uwsm-env.sh" "$DOTFILES/uwsm/.config/uwsm/env-theme"

# --- GTK theme / icon theme / cursor theme ----------------------------------
if [[ -f $THEME_DIR/meta.sh ]]; then
  # shellcheck source=/dev/null
  source "$THEME_DIR/meta.sh"
  [[ -n ${GTK_THEME_NAME:-} ]] && gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME"
  [[ -n ${ICON_THEME_NAME:-} ]] && gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME_NAME"
  [[ -n ${CURSOR_THEME_NAME:-} ]] && gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME_NAME"
  [[ -n ${CURSOR_SIZE:-} ]] && gsettings set org.gnome.desktop.interface cursor-size "$CURSOR_SIZE"
fi

# --- Wallpaper (optional per-theme default) ---------------------------------
if [[ -f $THEME_DIR/wallpaper.png ]]; then
  CURRENT_LINK="$HOME/.local/share/wallpapers/.current"
  ln -sfr "$THEME_DIR/wallpaper.png" "$CURRENT_LINK"
  command -v hyprctl &>/dev/null && hyprctl hyprpaper wallpaper ",$CURRENT_LINK,cover" &>/dev/null
fi

echo "Done. (cursor theme and Qt's QT_QPA_PLATFORMTHEME need a full session relogin to fully take effect everywhere — GTK theme/icons and everything else above is already live.)"
