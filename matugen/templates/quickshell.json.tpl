{
  "_comment": "Generated by matugen from matugen/templates/quickshell.json.tpl — derived data, regenerated by `theme wallpaper`. Same role contract as themes/tokyonight/quickshell.json. ok/warn/info are hue-rotated from primary (same trick as the kitty template's ANSI palette) so they stay distinguishable on low-chroma wallpapers.",
  "name": "wallpaper",
  "bg": "{{ colors.surface_container_lowest.default.hex }}",
  "surface": "{{ colors.surface_container_low.default.hex }}",
  "surfaceHi": "{{ colors.surface_container_highest.default.hex }}",
  "fg": "{{ colors.on_surface.default.hex }}",
  "subtle": "{{ colors.on_surface_variant.default.hex }}",
  "muted": "{{ colors.outline.default.hex }}",
  "border": "{{ colors.outline_variant.default.hex }}",
  "accent": "{{ colors.primary.default.hex }}",
  "accent2": "{{ colors.tertiary.default.hex }}",
  "info": "{{ colors.primary.default.hex | to_color | set_hue: 195 | format: "hex" }}",
  "ok": "{{ colors.primary.default.hex | to_color | set_hue: 120 | format: "hex" }}",
  "warn": "{{ colors.primary.default.hex | to_color | set_hue: 40 | format: "hex" }}",
  "err": "{{ colors.error.default.hex }}",
  "islandOpacity": 0.86
}
