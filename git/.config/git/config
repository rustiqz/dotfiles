# ~/.config/git/config
#
# Identity (user.name/email) deliberately isn't here: this file is
# public (pushed to GitHub), and an email address doesn't belong in a
# public repo just because the rest of the config can be. It lives in
# config.local instead — untracked, seeded once by hooks/50-git-identity.sh
# — and included below. `[include]` with a path that doesn't exist yet
# is silently skipped, so this is safe before that hook has ever run.

[include]
	path = ~/.config/git/config.local

[init]
	defaultBranch = main

[push]
	# `git push` on a new branch creates+tracks the remote branch instead
	# of erroring and telling you to pass --set-upstream every time.
	autoSetupRemote = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n/N jump between diff hunks, like a pager search
	line-numbers = true
	side-by-side = false
	# Reuses the same TokyoNight theme bat installs (hooks/41-bat-theme.sh);
	# delta looks in bat's theme directory automatically. Name is the
	# filename stem, not the theme's internal `name` key — see
	# bat/.config/bat/config for how that was confirmed.
	syntax-theme = tokyonight_night
	plus-style                = "syntax #1e2f24"
	plus-emph-style            = "syntax #2c4a37"
	minus-style               = "syntax #35222b"
	minus-emph-style           = "syntax #55293a"
	file-style                = "#7aa2f7 bold"
	file-decoration-style     = "#7aa2f7 ul"
	hunk-header-style         = "file line-number syntax"
	hunk-header-decoration-style = "#565f89 box"
	commit-style              = "raw"
	commit-decoration-style   = "#e0af68 box"
	line-numbers-left-color   = "#414868"
	line-numbers-right-color  = "#414868"
	line-numbers-minus-style  = "#f7768e"
	line-numbers-plus-style   = "#9ece6a"

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
