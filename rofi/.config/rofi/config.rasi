/* ~/dotfiles/rofi/.config/rofi/config.rasi
 *
 * App launcher only (drun mode) for now — window switcher / other modes
 * are easy to add later (`modi` list, or a second keybind with -show
 * window) but weren't asked for, so kept out rather than guessed in.
 *
 * No hardcoded colors in this file — active-theme.rasi is a symlink
 * (bin/bin/theme repoints it, see themes/<name>/rofi.rasi) defining
 * @background/@foreground/etc., imported below. Icons come from the
 * system icon theme via freedesktop lookup (show-icons below), not a
 * Nerd Font glyph, so there's no PUA codepoint to get wrong.
 *
 * Note: on Wayland, rofi can't detect clicks outside its own window (a
 * rofi 2.0 backend limitation). Click-away is provided from outside instead:
 * quickshell/.../modules/external/ExternalScrim.qml shows a scrim while a
 * `rofi` layer exists and kills rofi when it's clicked.
 */

@import "active-theme.rasi"

configuration {
  modi: "drun,run";
  show-icons: true;
  font: "JetBrainsMono Nerd Font 11";
  display-drun: "Apps";
}

* {
  background-color:   @background;
  text-color:         @foreground;
}

/* Shaped like the Quickshell popups (power menu, launcher): Theme.radius+4
 * corners and a 1px quiet border, with the accent kept for the prompt and
 * selection instead of an outline. */
window {
  width: 600px;
  border: 1px;
  border-color: @border;
  border-radius: 18px;
}

mainbox {
  padding: 12px;
}

inputbar {
  background-color: @background-alt;
  text-color: @foreground;
  padding: 10px 14px;
  border-radius: 12px;
  spacing: 8px;
}

prompt {
  background-color: transparent;
  text-color: @accent;
}

entry {
  background-color: transparent;
  text-color: @foreground;
  placeholder-color: @muted;
}

listview {
  margin: 8px 0 0 0;
  lines: 8;
  scrollbar: false;
}

/* Rofi's stock theme alternates row backgrounds (normal vs. alternate
 * state) using its own default (light) colors. A bare `element { }` rule
 * doesn't override the `alternate` state specifically — it's a more
 * specific selector than `element` in rofi's cascade, so it was still
 * winning and showing through as an unreadably light stripe every other
 * row. Setting all three states explicitly kills that entirely — flat,
 * one background color throughout, matching the rest of this repo's
 * "no alternating/pill styling" preference.
 */
element {
  padding: 7px 10px;
  border-radius: 10px;
  spacing: 10px;
}

element normal.normal,
element alternate.normal {
  background-color: @background;
  text-color: @foreground;
}

element selected.normal {
  background-color: @selected;
  text-color: @accent;
}

element-icon {
  size: 20px;
}
